# Copy this file to .env and replace every <...> placeholder.
# Backend variables are read by FastAPI. Never commit the resulting .env file.
# Values below are production-shaped placeholders; use separate values locally.

# ==================== BACKEND: DATABASE ====================
DB_HOST=<production-db-host>
DB_PORT=3306
DB_USER=<production-db-user>
DB_PASSWORD=<production-db-password>
DB_NAME=realestate
DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:3306/realestate

# ==================== BACKEND: AUTH ====================
JWT_SECRET=<generate-a-long-random-production-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=<production-admin-email>
ADMIN_PASSWORD=<production-admin-password>

# ==================== BACKEND: AI / RAG ====================
GROQ_API_KEY=<production-groq-api-key>
GROQ_MODEL=openai/gpt-oss-20b

# ==================== BACKEND: CORS / STORAGE ====================
# Comma-separate additional trusted frontend origins when needed.
CORS_ORIGINS=https://<production-frontend-domain>
UPLOAD_DIR=/app/uploads
CHROMA_PERSIST_DIR=/app/chroma_db
ML_ARTIFACTS_DIR=/app/app/ml/artifacts

# ==================== FRONTEND (BUILD TIME ONLY) ====================
# Vite embeds this value into the static bundle. Do not put backend secrets
# (GROQ_API_KEY, database credentials, JWT secrets, etc.) in VITE_* variables.
VITE_API_URL=https://<production-backend-domain>/api
